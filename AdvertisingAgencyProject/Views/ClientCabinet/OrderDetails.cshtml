@using AdvertisingAgencyProject.Services
@model AdvertisingAgencyProject.Models.AdOrder

@{
    ViewData["Title"] = "Детали заявки";
}

<h1>Детали заявки</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>
        <hr />

        <dl class="row mb-0">
            <dt class="col-sm-3">Категория</dt>
            <dd class="col-sm-9">@Model.AdCategory?.Name</dd>

            <dt class="col-sm-3">Описание</dt>
            <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Description) ? Model.Description : "—")</dd>

            <dt class="col-sm-3">Дата начала</dt>
            <dd class="col-sm-9">@Model.StartDate.ToString("dd.MM.yyyy")</dd>

            <dt class="col-sm-3">Дата окончания</dt>
            <dd class="col-sm-9">@Model.EndDate.ToString("dd.MM.yyyy")</dd>

            <dt class="col-sm-3">Стоимость</dt>
            <dd class="col-sm-9">@Model.TotalPrice.ToString("0.00")</dd>

            <dt class="col-sm-3">Статус</dt>
            <dd class="col-sm-9">
                <span class="badge @AdOrderWorkflowService.ToBadgeClass(Model.Status)">
                    @AdOrderWorkflowService.ToDisplayText(Model.Status)
                </span>
            </dd>

            <dt class="col-sm-3">Активна</dt>
            <dd class="col-sm-9">@(Model.IsActive ? "Да" : "Нет")</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Orders" class="btn btn-secondary">Назад к списку</a>
</div>