@using AdvertisingAgencyProject.Services
@model IEnumerable<AdvertisingAgencyProject.Models.AdOrder>

@{
    ViewData["Title"] = "Мои заявки";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Мои заявки</h1>
    <a asp-action="CreateRequest" class="btn btn-success">Новая заявка</a>
</div>

@if (Model.Any())
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Название</th>
                <th>Категория</th>
                <th>Период</th>
                <th>Стоимость</th>
                <th>Статус</th>
                <th>Активна</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.AdCategory?.Name</td>
                    <td>@item.StartDate.ToString("dd.MM.yyyy") - @item.EndDate.ToString("dd.MM.yyyy")</td>
                    <td>@item.TotalPrice.ToString("0.00")</td>
                    <td>
                        <span class="badge @AdOrderWorkflowService.ToBadgeClass(item.Status)">
                            @AdOrderWorkflowService.ToDisplayText(item.Status)
                        </span>
                    </td>
                    <td>@(item.IsActive ? "Да" : "Нет")</td>
                    <td>
                        <a asp-action="OrderDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Подробнее</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        У вас пока нет заявок.
    </div>
}